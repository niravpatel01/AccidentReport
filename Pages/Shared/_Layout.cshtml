<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Accident Diagram Builder</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="container-fluid d-flex align-items-center gap-3 py-2 px-3 px-lg-4">
            <div class="brand-icon"><i class="bi bi-sign-intersection-fill"></i></div>
            <div>
                <div class="brand-title">Accident Diagram Builder</div>
                <div class="brand-subtitle">Create a clear accident scene and export a professional PDF</div>
            </div>
            <div class="header-actions">
                <label class="header-btn" for="loadFile" title="Open a saved diagram"><i class="bi bi-folder2-open"></i><span>Open</span></label>
                <input id="loadFile" type="file" accept="application/json,.json" hidden />
                <button id="saveBtn" class="header-btn" type="button" title="Save editable diagram"><i class="bi bi-floppy"></i><span>Save</span></button>
                <button id="pdfBtn" class="header-btn header-btn-primary" type="button" title="Download PDF"><i class="bi bi-file-earmark-pdf"></i><span>Download PDF</span></button>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <div id="appToast" class="toast align-items-center text-bg-dark border-0 position-fixed bottom-0 end-0 m-3" role="status" aria-live="polite" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="appToastMessage">Done</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/fabric/fabric.min.js"></script>
    <script src="~/lib/jspdf/jspdf.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
